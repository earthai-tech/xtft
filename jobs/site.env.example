# Copy to jobs/site.env (untracked) and adapt to your cluster.
# Sourced by every jobs/*.sbatch script.

# conda's shell hook and the project environment.
XTFT_CONDA_SH=$HOME/miniforge3/etc/profile.d/conda.sh
XTFT_ENV=$HOME/envs/xtft

# Large, fast storage for datasets, results and logs of runs
# (a scratch or work file system on most clusters).
XTFT_SCRATCH=$HOME/xtft-scratch
